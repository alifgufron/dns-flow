#!/bin/sh
#
# PROVIDE: dns_flow
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown
#
# FreeBSD rc.d script for dns-flow
# Install to /usr/local/etc/rc.d/dns-flow
#
# Enable in /etc/rc.conf:
#   dns_flow_enable="YES"
#   dns_flow_config="/usr/local/etc/dns-flow.yaml"
#   dns_flow_user="dnsflow"
#   dns_flow_group="dnsflow"
#   dns_flow_logfile="/var/log/dns-flow/dns-flow.log"   # empty = syslog
#   dns_flow_rundir="/var/run/dns-flow"                 # unix socket location

. /etc/rc.subr

name="dns_flow"
rcvar="dns_flow_enable"

load_rc_config "$name"

: ${dns_flow_enable:="NO"}
: ${dns_flow_config:="/usr/local/etc/dns-flow.yaml"}
: ${dns_flow_user:="dnsflow"}
: ${dns_flow_group:="dnsflow"}
: ${dns_flow_logfile:="/var/log/dns-flow/dns-flow.log"}
: ${dns_flow_rundir:="/var/run/dns-flow"}
: ${dns_flow_datadir:="/var/db/dns-flow"}

pidfile="${dns_flow_rundir}/${name}.pid"
procname="/usr/local/sbin/dns-flow"
command="/usr/sbin/daemon"

# daemon(8) drops privileges and supervises the process. Output is sent to a
# logfile when configured, otherwise to syslog, so log data is never lost.
if [ -n "${dns_flow_logfile}" ]; then
	_output_args="-o ${dns_flow_logfile}"
else
	_output_args="-S -T ${name}"
fi

command_args="-f -p ${pidfile} -u ${dns_flow_user} ${_output_args} \
	${procname} -config ${dns_flow_config}"

start_precmd="${name}_prestart"
reload_cmd="${name}_reload"
status_cmd="${name}_status"
extra_commands="reload configtest"
configtest_cmd="${name}_configtest"

dns_flow_prestart() {
	if [ ! -f "${dns_flow_config}" ]; then
		err 1 "Config file ${dns_flow_config} not found"
	fi

	if ! pw groupshow "${dns_flow_group}" >/dev/null 2>&1; then
		echo "Group ${dns_flow_group} does not exist; create with:"
		echo "  pw groupadd ${dns_flow_group}"
		return 1
	fi

	if ! pw usershow "${dns_flow_user}" >/dev/null 2>&1; then
		echo "User ${dns_flow_user} does not exist; create with:"
		echo "  pw adduser ${dns_flow_user} -g ${dns_flow_group} -d /nonexistent -s /usr/sbin/nologin"
		return 1
	fi

	# Runtime directory holds the DNSTAP unix socket created by dns-flow and pidfile.
	# Mode 750 with the service group lets a DNS server in that group connect.
	install -d -o "${dns_flow_user}" -g "${dns_flow_group}" -m 750 "${dns_flow_rundir}"
	install -d -o "${dns_flow_user}" -g "${dns_flow_group}" -m 750 "${dns_flow_datadir}"
	touch "${pidfile}" 2>/dev/null || true
	chown "${dns_flow_user}:${dns_flow_group}" "${pidfile}" 2>/dev/null || true

	if [ -n "${dns_flow_logfile}" ]; then
		install -d -o "${dns_flow_user}" -g "${dns_flow_group}" -m 750 \
			"$(dirname "${dns_flow_logfile}")"
	fi
}

dns_flow_configtest() {
	if [ ! -f "${dns_flow_config}" ]; then
		echo "Config file ${dns_flow_config} not found"
		return 1
	fi
	echo "Config file ${dns_flow_config} found."
	echo "Note: full validation happens at startup; check the log after starting."
}

dns_flow_reload() {
	if [ ! -f "${pidfile}" ]; then
		echo "${name} is not running."
		return 1
	fi
	local pid
	pid=$(cat "${pidfile}" 2>/dev/null | tr -d ' \t\r\n')
	if kill -HUP "${pid}" 2>/dev/null; then
		echo "${name} reloaded config (SIGHUP sent to pid ${pid})."
	else
		echo "Failed to send SIGHUP to ${name} (pid ${pid})."
		return 1
	fi
}

dns_flow_status() {
	if [ ! -f "${pidfile}" ]; then
		echo "${name} is not running (no pidfile)."
		return 1
	fi

	local pid
	pid=$(cat "${pidfile}" 2>/dev/null | tr -d ' \t\r\n')
	case "${pid}" in
		""|*[!0-9]*)
			echo "${name} is not running (invalid pidfile)."
			return 1
			;;
	esac

	if kill -0 "${pid}" 2>/dev/null; then
		echo "${name} is running as pid ${pid}."
		return 0
	else
		echo "${name} is not running (stale pidfile ${pidfile})."
		rm -f "${pidfile}"
		return 1
	fi
}

run_rc_command "$1"
